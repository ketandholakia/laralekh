{
    "name": "laravix/laravix",
    "type": "project",
    "description": "Multi-tenant Indian GST accounting",
    "license": "proprietary",
    "require": {
        "php": "^8.4.1",
        "ext-bcmath": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "chillerlan/php-qrcode": "^6.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "livewire/livewire": "^3.8",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.5"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/pestphp/pest/bin/pest"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}